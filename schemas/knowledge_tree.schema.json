{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/knowledge-catalog/schemas/knowledge-tree-1.0.0.json",
  "title": "Knowledge Catalog Tree",
  "description": "Stable downstream knowledge-tree contract. Provenance and release metadata live in a sidecar manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "selected_range", "children"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "selected_range": {"type": "string", "minLength": 1},
    "children": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "scope", "children"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "scope": {"type": ["string", "null"], "maxLength": 4000},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        }
      }
    }
  },
  "x-schema-version": "1.0.0"
}
